        "lineHeight": "20px",
        "letterSpacing": "0",
        "usage": "Button"
      },
      "caption": {
        "token": "instrument.ui.caption",
        "fontFamily": "Source Sans Pro, sans-serif",
        "fontWeight": 400,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0",
        "usage": "Caption/Helper Text"
      }
