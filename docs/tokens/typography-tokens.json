        "token": "instrument.special.kpi",
        "fontFamily": "Urbanist, sans-serif",
        "fontWeight": 400,
        "fontSize": "48px",
        "lineHeight": "56px",
        "letterSpacing": "-0.01em",
        "usage": "KPI/Big Number"
      }
    },
    "ui": {
      "tableHeader": {
        "token": "instrument.ui.table-header",
        "fontFamily": "Source Sans Pro, sans-serif",
        "fontWeight": 600,
        "fontSize": "14px",
        "lineHeight": "20px",
        "letterSpacing": "0.01em",
        "textTransform": "uppercase",
        "usage": "Table Header"
      },
      "inputLabel": {
        "token": "instrument.ui.input-label",
