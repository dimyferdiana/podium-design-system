{
  "typography": {
    "fontFamilies": {
      "poppins": "Poppins, sans-serif",
      "urbanist": "Urbanist, sans-serif",
      "inter": "Inter, sans-serif",
      "sourceSansPro": "Source Sans Pro, sans-serif"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semiBold": 600,
      "bold": 700
    },
    "headings": {
      "pageTitle": {
        "token": "instrument.heading.page-title",
        "fontFamily": "Poppins, sans-serif",
        "fontWeight": 600,
        "fontSize": "30px",
        "lineHeight": "40px",
        "letterSpacing": "-0.015em",
        "usage": "H1 Page Title (e.g., 'Sales Dashboard')"
      },
      "cardTitle": {
        "token": "instrument.heading.card-title",
        "fontFamily": "Poppins, sans-serif",
        "fontWeight": 500,
        "fontSize": "20px",
        "lineHeight": "28px",
        "letterSpacing": "0",
        "usage": "H2 Card/Widget Title"
      },
      "listTitle": {
        "token": "instrument.heading.list-title",
        "fontFamily": "Urbanist, sans-serif",
        "fontWeight": 500,
        "fontSize": "18px",
        "lineHeight": "24px",
        "letterSpacing": "0",
        "usage": "H3 Table/List Title"
      }
    },
    "body": {
      "default": {
        "token": "instrument.body.default",
        "fontFamily": "Inter, sans-serif",
        "fontWeight": 400,
        "fontSize": "16px",
        "lineHeight": "24px",
        "letterSpacing": "0",
        "usage": "Body text, data tables"
      },
      "small": {
        "token": "instrument.body.small",
        "fontFamily": "Inter, sans-serif",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "20px",
        "letterSpacing": "0",
